@model CalcViewModel
<div class="calc-action-container">
    <!--Calculate-->
    @if (Model.ShowFullButton)
    {
        <!--HT-->
        <div class="calc-action-row">
            <div class="calc-action-header">
                @ViewResources.FirstHalf
            </div>
            <div class="calc-action-status @(Model.CurrentMatch.HtStatus == "Calculated" ? "bg-calculated" : "")">
                @Model.CurrentMatch.HtStatus
            </div>
            <div class="calc-action-button">
                @if (Model.Permission.SportsBook.CanCalculate)
                {
                    <div class="act-calc-ht calc-button">@ViewResources.CalculateHT</div>
                }
            </div>
        </div>
        <!--FT-->
        <div class="calc-action-row">
            <div class="calc-action-header">
                @ViewResources.FullTime
            </div>
            <div class="calc-action-status @(Model.CurrentMatch.FtStatus == "Calculated" ? "bg-calculated" : "")">
                @Model.CurrentMatch.FtStatus
            </div>
            <div class="calc-action-button">
                @if (Model.Permission.SportsBook.CanCalculate)
                {
                    <div class="@( Model.CurrentMatch.IsHtOnly || Model.CurrentMatch.HtStatus == "Running" ? "calc-button-disabled" : "act-calc-ft calc-button")">@ViewResources.CalculateFT</div>
                }
            </div>
        </div>
        <!--FGLG-->
                if (Model.CurrentMatch.IsExistFGLG && Model.CurrentMatch.IsExistHTFGLG)
                {
        <div class="calc-action-row">
            <div class="calc-action-header">
                @ViewResources.HTFGLG
            </div>
            <div class="calc-action-status @(Model.CurrentMatch.HtFgLgStatus.Equals("Calculated") ? "bg-calculated" : "")">
                @Model.CurrentMatch.HtFgLgStatus
            </div>
        </div>
        <div class="calc-action-row">
            <div class="calc-action-header">
                @ViewResources.FTFGLG
            </div>
            <div class="calc-action-status @(Model.CurrentMatch.FgLgStatus.Equals("Calculated") ? "bg-calculated" : "")">
                @Model.CurrentMatch.FgLgStatus
            </div>
            <div class="calc-action-button">
                @if (Model.Permission.SportsBook.CanCalculate)
                {
                    <div class="act-calc-fgng all-fgng">@ViewResources.CalculateFGNG</div>
                }
            </div>
        </div>
                }
                else if (Model.CurrentMatch.IsExistFGLG)
                {
        <div class="calc-action-row">
            <div class="calc-action-header">
                @ViewResources.FTFGLG
            </div>
            <div class="calc-action-status @(Model.CurrentMatch.FgLgStatus.Equals("Calculated") ? "bg-calculated" : "")">
                @Model.CurrentMatch.FgLgStatus
            </div>
            <div class="calc-action-button">
                @if (Model.Permission.SportsBook.CanCalculate)
                {
                    <div class="act-calc-fgng">@ViewResources.CalculateFGNG</div>
                }
            </div>
        </div>
                }
                else if (Model.CurrentMatch.IsExistHTFGLG)
                {
        <div class="calc-action-row">
            <div class="calc-action-header">
                @ViewResources.HTFGLG
            </div>
            <div class="calc-action-status @(Model.CurrentMatch.HtFgLgStatus.Equals("Calculated") ? "bg-calculated" : "")">
                @Model.CurrentMatch.HtFgLgStatus
            </div>
            <div class="calc-action-button">
                @if (Model.Permission.SportsBook.CanCalculate)
                {
                    <div class="act-calc-fgng">@ViewResources.CalculateFGNG</div>
                }
            </div>
        </div>
                }
    }
    <!--CalculateAll-->
    <div class="calc-all-action">
        @{
            var calculated = Model.CurrentMatch.HtStatus == "Calculated" || Model.CurrentMatch.FtStatus == "Calculated"
                             || Model.CurrentMatch.FgLgStatus == "Calculated";
            var betStatus = string.IsNullOrEmpty(Model.CurrentMatch.BetStatus) ? string.Empty : Model.CurrentMatch.BetStatus.ToLower();

        }
        @if (Model.Permission.SportsBook.CanCalculate)
        {
            <div class="@(Model.CurrentMatch.IsHtOnly ? "calc-all-disabled" : "act-calc-all calc-all-button")">@ViewResources.CalculateAll</div>
        }
        @if (Model.Permission.SportsBook.CanUncalculate)
        {
            <div class="act-uncalc calc-all-button">@ViewResources.Uncalculate</div>
        }
    </div>
</div>
<!--GoalRecord-->
<div class="ht-goal-record">
    @if (!string.IsNullOrEmpty(Model.CurrentMatch.GoalRecord) && Model.CurrentMatch.SportType == SportType.Soccer &&
        Model.CurrentMatch.IsExistHTFGLG && Model.CurrentMatch.GoalRecord.IndexOf(";") > -1 && !Model.CurrentMatch.GoalRecord.Equals(";"))
    {
        var halfTimeFirstLastGoal = Model.CurrentMatch.GoalRecord.Split(';')[0];
        Html.RenderPartial("~/Areas/Settlement/Views/UserControl/GoalRecord.cshtml", Tuple.Create(true, halfTimeFirstLastGoal));

    }
</div>
<div class="goal-record">
    @if (!string.IsNullOrEmpty(Model.CurrentMatch.GoalRecord) && Model.CurrentMatch.SportType == SportType.Soccer && !Model.CurrentMatch.GoalRecord.Equals(";"))
    {
        var lastGoal = Model.CurrentMatch.GoalRecord.Replace(";", string.Empty);
        Html.RenderPartial("~/Areas/Settlement/Views/UserControl/GoalRecord.cshtml", Tuple.Create(false, lastGoal));
    }
</div>
<div class="clear">
</div>