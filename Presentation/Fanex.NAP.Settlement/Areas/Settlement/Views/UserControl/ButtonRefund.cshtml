@using Fanex.NAP.Settlement.DTO.Domain
@model RefundViewModel
<div class="display-button">
    <!-- Refund -->
    <div class="line-height-refund">
        @{
            var isShowRefundHt = ((string.IsNullOrEmpty(Model.CurrentMatch.BetStatus)
                                   || !Model.CurrentMatch.BetStatus.Contains("Refund HT"))
                                  && (Model.CurrentMatch.SportType == SportType.Soccer
                                  || Model.CurrentMatch.SportType == SportType.BasketBall))
                                 || Model.CurrentMatch.SportType == SportType.FootBall
                                 || Model.CurrentMatch.SportType == SportType.BaseBall
                                 || Model.CurrentMatch.SportType == SportType.NetBall
                                 || Model.CurrentMatch.SportType == SportType.Rugby;

        }
        @if (isShowRefundHt)
        {
            <div class="refund-button act-refund-ht">@ViewResources.RefundHT</div>

        }
        <div class="refund-button act-refund-ft">@ViewResources.RefundFT</div>
        <div class="refund-button act-refund-all">@ViewResources.RefundAll</div>
        <div class="clear">
        </div>
        <!-- Refund Parlay -->
        <div>
            @{
                var isShowParlayHt = Model.CurrentMatch.SportType == SportType.Soccer || Model.CurrentMatch.SportType == SportType.BasketBall;
                var isShowParlayFt = false;
                if (Model.CurrentMatch.SportType == SportType.FootBall
                    || Model.CurrentMatch.SportType == SportType.BaseBall
                    || Model.CurrentMatch.SportType == SportType.Soccer
                    || Model.CurrentMatch.SportType == SportType.BasketBall
                    || Model.CurrentMatch.SportType == SportType.Rugby)
                {
                    if (Model.CurrentMatch.SportType == SportType.FootBall
                        || Model.CurrentMatch.SportType == SportType.BaseBall
                        || Model.CurrentMatch.SportType == SportType.Rugby)
                    {
                        isShowParlayFt = true;
                    }
                    else if (!string.IsNullOrEmpty(Model.CurrentMatch.BetStatus) && Model.CurrentMatch.BetStatus.Contains("Refund HT"))
                    {
                        isShowParlayFt = false;
                    }
                    else
                    {
                        isShowParlayFt = true;
                    }
                }

                if (isShowParlayHt)
                {
                <div class="refund-button act-refund-parlay-ht">@ViewResources.RefundMultiHT</div>
                }
                if (isShowParlayFt)
                {
                <div class="refund-button act-refund-parlay-ft">@ViewResources.RefundMultiFT</div>
                }
                <div class="refund-button act-refund-parlay-all">@ViewResources.RefundMultiAll</div>
            }
        </div>
        <div class="clear">
        </div>
        <!-- Refund FGLG -->
        @if (Model.CurrentMatch.SportType == SportType.Soccer)
        {
            if (Model.CurrentMatch.IsExistHTFGLG)
            {
            <div class="refund-button act-refund-ht-fglg">@ViewResources.RefundHTFGLG</div>
            }

            if (Model.CurrentMatch.IsExistFGLG)
            {
            <div class="refund-button act-refund-ft-fglg">@ViewResources.RefundFTFGLG</div>
            }

            if (Model.CurrentMatch.IsExistHTFGLG || Model.CurrentMatch.IsExistFGLG)
            {
            <div class="refund-button act-refund-all-fglg">@ViewResources.RefundAllFGLG</div>
            }
            <div class="clear">
            </div>

            if (Model.CurrentMatch.IsExistHTLG)
            {
            <div class="refund-button act-refund-ht-lg">@ViewResources.RefundHTLastGoal</div>
            }

            if (Model.CurrentMatch.IsExistLG)
            {
            <div class="refund-button act-refund-ft-lg">@ViewResources.RefundFTLastGoal</div>
            }

            if (Model.CurrentMatch.IsExistHTLG || Model.CurrentMatch.IsExistLG)
            {
            <div class="refund-button act-refund-all-lg">@ViewResources.RefundAllLastGoal</div>
            }
            <div class="clear">
            </div>
        }
    </div>
    <div class="clear">
    </div>
</div>