@model Tuple<Boolean, String>
@{
    var isHalfTimeFirstLastGoal = Model.Item1;
    var goalRecord = Model.Item2;
    var homeScore = 0;
    var awayScore = 0;
}
<div class="header">
    @(isHalfTimeFirstLastGoal ? ViewResources.HTGoalRecord : ViewResources.FTGoalRecord)
</div>
<div class="content">
    @foreach (var goal in goalRecord)
    {
        homeScore += 'h' == char.ToLower(goal) ? 1 : 0;
        awayScore += 'a' == char.ToLower(goal) ? 1 : 0;
        <div class="goal-row">
            <div class="goal-score">
                @homeScore - @awayScore
            </div>
            <div>
                @(Equals('h', char.ToLower(goal)) ? ViewResources.Home : ViewResources.Away)
            </div>
        </div>
    }
</div>