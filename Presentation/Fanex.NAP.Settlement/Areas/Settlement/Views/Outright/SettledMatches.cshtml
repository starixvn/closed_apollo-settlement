@{
    ViewBag.Title = "Outright Uncalculate";
    Layout = "Shared/_LayoutPopup.cshtml";
}
@model OutrightLogActionViewModel
<div id="tab-title">
    <div class="left">
    </div>
    <div class="middle">@Model.LeagueName
        @Html.Hidden("leagueId", Model.LeagueId)
    </div>
    <div class="right">
    </div>
</div>
<div class="clear">
</div>
<div>
    @using (Html.BeginForm())
    {
        <table class="table-calculation">
            <thead>
                <tr>
                    <th>@ViewResources.Team
                    </th>
                    <th class="code">
                        @ViewResources.Result
                    </th>
                    <th class="code">
                        @ViewResources.SelectTeam
                    </th>
                    <th class="confirm">
                        @ViewResources.Confirm
                    </th>
                </tr>
            </thead>
            @if (Model.OutrightList.Any())
            {

                <tbody>
                    @{

                var outrightList = Model.OutrightList;
                var index = 0;
                var countDeadHeat = 0;
                var orIds = string.Empty;
                var teamIds = string.Empty;
                var isFailed = false;

                foreach (var item in outrightList)
                {
                    index++;
                    teamIds += string.Join("|", item.TeamId, "");
                    var oddOrEven = index % 2 != 0 ? string.Empty : "even";
                        <tr class="@oddOrEven">
                            <td class="match-home">
                                @item.TeamName
                            </td>
                            <td style="padding: 3px 0;">
                                <div style="text-transform: capitalize;">
                                    @(!string.IsNullOrEmpty(item.Status) ? item.Status.ToLower() : string.Empty)
                                </div>
                                @if (item.FailedActionId > 0)
                                {
                                    isFailed = true;
                                    <div style="color: Red">@Utility.GetActionStatusById(item.FailedActionId)</div>
                                }
                            </td>
                            <td align="center">
                                @{
                                var statusId = 1;
                                if (!string.IsNullOrEmpty(item.Status))
                                {
                                    switch (item.Status.ToLower())
                                    {
                                        case "won":
                                            countDeadHeat++;
                                            statusId = OutrightStatus.Won;
                                            break;
                                        case "lose":
                                            statusId = OutrightStatus.Lose;
                                            break;
                                        case "refund":
                                            statusId = OutrightStatus.Refund;
                                            break;
                                    }
                                }
                                orIds += string.Format("{0},{1}|", item.OrId, statusId);
                                if (Model.Permission.CanUncalculateOutright)
                                {
                                    @Html.CheckBox("team-" + item.TeamId, new { @class = "select-team", @value = statusId })
                                }
                                else
                                {
                                    @Html.CheckBox("team-" + item.TeamId, new { @class = "select-team", @value = statusId, @disabled = "disabled" })
                                }

                                }
                            </td>
                            <td align="left">
                                @{
                                var listAction = Model.LogActionList.Where(m => m.OrId == item.OrId).ToList();
                                var i = 0;
                                var count = listAction.Count;
                                if (count > 0)
                                {
                                    foreach (var action in listAction)
                                    {
                                    <div class="calc-notifier disable">
                                        @Utility.UppercaseFirst(action.Status)
                                    </div>
                                        if (i < (count - 1))
                                        {
                                    @Html.Raw("&nbsp;»");
                                        }
                                        i++;
                                    }
                                    <div class="act-view-log" style="text-decoration: underline; margin-left: 4px;
                            margin-top: 5px; color: #0273FF; cursor: pointer" data-orid="@item.OrId"  data-team-id="@item.TeamId">
                                        @ViewResources.ViewLog</div>
                                }
                                }
                            </td>
                        </tr>

                }

                    }
                    @if (isFailed)
                    {
                        <tr>
                            <td colspan="4">
                                <div class="calc-all-disabled">
                                    @ViewResources.Uncalculate</div>
                                <div class="error" style="padding: 7px 0 0 25px; text-align: left">
                                    @ViewResources.MsgUncalculateOutright
                                </div>
                            </td>
                        </tr>
                    }
                    else if (Model.Permission.CanUncalculateOutright)
                    {
                        <tr>
                            <td colspan="4">
                                <div class="calc-all-disabled" id="uncal">
                                    @ViewResources.Uncalculate</div>
                                @Html.Hidden("orIds", orIds)
                                @Html.Hidden("teamIds", teamIds)
                                @Html.Hidden("countDeadHeat", countDeadHeat)
                            </td>
                        </tr>
                    }
                </tbody>

            }
            else
            {
                <tr>
                    <td colspan="4">
                        @ViewResources.EmptyMessage
                    </td>
                </tr>
            }
        </table>
    }
</div>
@section scripts
{
    <script type="text/javascript">
        jQuery(window).load(function () {
            // Event click to UnCalculate
            $("#outright").on("click", ".act-uncalc", OUTRIGHT.unCalculate);

            // Event click to View log action.
            $("#outright").on("click", ".act-view-log", OUTRIGHT.openPopupLog);

            // Event change to select team.
            $("#outright").on("click", ".select-team", OUTRIGHT.selectTeam);
        });
    </script>
}