@using Fanex.NAP.Settlement.DTO.Permission;
@model Tuple<Match, SettlementPermission, PageType, String>
@{
    var match = Model.Item1;
    var page = Model.Item3;
}
@{
    switch (page)
    {
        case PageType.Refund:
        case PageType.Calc:
            Layout = "RowOnPopup.cshtml";
            break;
        default:
            Layout = "RowOnList.cshtml";
            break;
    }
}
@section HomeScore{
    <td class="score-betstatus home-away">
        @Html.TextBoxOrLabel(page, "Home1Q", match.BetStatusAccess.Home1Q, false, new { @class = "score-width", @tabindex = 1 })
    </td>
    <td class="score-betstatus home-away">
        @Html.TextBoxOrLabel(page, "Home2Q", match.BetStatusAccess.Home2Q, false, new { @class = "score-width", @tabindex = 3 })
    </td>
    <td class="score-betstatus home-away">
        @Html.TextBoxOrLabel(page, "Home3Q", match.BetStatusAccess.Home3Q, false, new { @class = "score-width", @tabindex = 5 })
    </td>
    <td class="score-betstatus home-away">
