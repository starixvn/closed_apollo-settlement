@using Fanex.NAP.Settlement.DTO.Domain
@using Fanex.NAP.Settlement.DTO.Permission;
@model Tuple<Match, SettlementPermission, PageType, String>
@{
    var match = Model.Item1;
    var page = Model.Item3;
}
@{
    switch (page)
    {
        case PageType.Refund:
        case PageType.Calc:
            Layout = "RowOnPopup.cshtml";
            break;
        default:
            Layout = "RowOnList.cshtml";
            break;
    }
}
@section HomeScore{
    <td class="score-betstatus home-away">
        @Html.TextBoxOrLabel(page, "TextBoxHome1Q", match.BetStatusAccess.Home1Q, false, new { @class = "score-width", @tabindex = 1 })
        @Html.Hidden("TextBoxHome1Q_hidden", match.BetStatusAccess.Home1Q)
    </td>
