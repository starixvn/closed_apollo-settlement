        @Html.TextBoxOrLabel(page, "Home9Q", match.BetStatusAccess.Home9Q, false, new { @class = "score-width", @tabindex = 17 })
    </td>
    <td class="score-betstatus home-away">
        @Html.TextBoxOrLabel(page, "TextBoxHomeEI", match.BetStatusAccess.HomeEi, false, new { @class = "score-width", @tabindex = 19 })
    </td>
    <td class="score home-away">
        @Html.TextBoxOrLabel(page, "HtHomeScore", match.HtHomeScore, true, new { @class = "total-score-width", @tabindex = 21 })
    </td>
    <td class="score final-score-color home-away">
        @Html.TextBoxOrLabel(page, "FinalHomeScore", match.FinalHomeScore, true, new { @class = "final-score-color total-score-width", @tabindex = 23 })
    </td>
}
