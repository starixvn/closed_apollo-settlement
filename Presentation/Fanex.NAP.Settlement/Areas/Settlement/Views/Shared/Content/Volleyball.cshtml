@using Fanex.NAP.Settlement.DTO.Permission;
@model Tuple<Match, SettlementPermission, PageType, String>
@{
    var match = Model.Item1;
    var page = Model.Item3;
}
@{
    switch (page)
    {
        case PageType.Refund:
        case PageType.Calc:
            Layout = "RowOnPopup.cshtml";
            break;
        default:
            Layout = "RowOnList.cshtml";
            break;
    }
}
@section HomeScore{
    <td class="score-betstatus home-away">
        @Html.TextBoxOrLabel(page, "Home1Q", match.BetStatusAccess.Home1Q, false, new { @class = "score-width", @tabindex = 1 })
    </td>
    <td class="score-betstatus home-away">
        @Html.TextBoxOrLabel(page, "Home2Q", match.BetStatusAccess.Home2Q, false, new { @class = "score-width", @tabindex = 3 })
    </td>
    <td class="score-betstatus home-away">
        @Html.TextBoxOrLabel(page, "Home3Q", match.BetStatusAccess.Home3Q, false, new { @class = "score-width", @tabindex = 5 })
    </td>
    <td class="score-betstatus home-away">
        @Html.TextBoxOrLabel(page, "Home4Q", match.BetStatusAccess.Home4Q, false, new { @class = "score-width", @tabindex = 7 })
    </td>
    <td class="score-betstatus home-away">
        @Html.TextBoxOrLabel(page, "Home5Q", match.BetStatusAccess.Home5Q, false, new { @class = "score-width", @tabindex = 9 })
    </td>
    <td class="score total-game-color home-away">
        @Html.TextBoxOrLabel(page, "HomeTotalGames", match.BetStatusAccess.HomeTotalGames, true, new { @class = "total-score-width", @tabindex = 11 })
    </td>
    <td class="score final-score-color home-away">
        @Html.TextBoxOrLabel(page, "FinalHomeScore", match.FinalHomeScore, true, new { @class = "final-score-color total-score-width", @tabindex = 13 })
    </td>
}
@section AwayScore{
    <td class="score-betstatus">
        @Html.TextBoxOrLabel(page, "Away1Q", match.BetStatusAccess.Away1Q, false, new { @class = "score-width", @tabindex = 2 })
    </td>
    <td class="score-betstatus">
        @Html.TextBoxOrLabel(page, "Away2Q", match.BetStatusAccess.Away2Q, false, new { @class = "score-width", @tabindex = 4 })
    </td>
    <td class="score-betstatus">
        @Html.TextBoxOrLabel(page, "Away3Q", match.BetStatusAccess.Away3Q, false, new { @class = "score-width", @tabindex = 6 })
    </td>
    <td class="score-betstatus">
        @Html.TextBoxOrLabel(page, "Away4Q", match.BetStatusAccess.Away4Q, false, new { @class = "score-width", @tabindex = 8 })
    </td>
    <td class="score-betstatus">
        @Html.TextBoxOrLabel(page, "Away5Q", match.BetStatusAccess.Away5Q, false, new { @class = "score-width", @tabindex = 10 })
    </td>
    <td class="score total-game-color">
        @Html.TextBoxOrLabel(page, "AwayTotalGames", match.BetStatusAccess.AwayTotalGames, true, new { @class = "total-score-width", @tabindex = 12 })
    </td>
    <td class="score final-score-color">
        @Html.TextBoxOrLabel(page, "FinalAwayScore", match.FinalAwayScore, true, new { @class = "final-score-color total-score-width", @tabindex = 14 })
    </td>
}