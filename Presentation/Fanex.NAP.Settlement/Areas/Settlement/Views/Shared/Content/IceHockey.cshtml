@using Fanex.NAP.Settlement.DTO.Domain
@using Fanex.NAP.Settlement.DTO.Permission;
@model Tuple<Match, SettlementPermission, PageType, String>
@{
    var match = Model.Item1;
    var page = Model.Item3;
}
@{
    switch (page)
    {
        case PageType.Refund:
        case PageType.Calc:
            Layout = "RowOnPopup.cshtml";
            break;
        default:
            Layout = "RowOnList.cshtml";
            break;
    }
}
@section HomeScore{
    <td class="score-betstatus home-away">
        @Html.TextBoxOrLabel(page, "TextBoxHome1Q", match.BetStatusAccess.Home1Q, false, new { @class = "score-width", @tabindex = 1 })
        @Html.Hidden("TextBoxHome1Q_hidden", match.BetStatusAccess.Home1Q)
    </td>
    <td class="score-betstatus home-away">
        @Html.TextBoxOrLabel(page, "TextBoxHome2Q", match.BetStatusAccess.Home2Q, false, new { @class = "score-width", @tabindex = 3 })
        @Html.Hidden("TextBoxHome2Q_hidden", match.BetStatusAccess.Home2Q)
    </td>
    <td class="score-betstatus home-away">
        @Html.TextBoxOrLabel(page, "TextBoxHome3Q", match.BetStatusAccess.Home3Q, false, new { @class = "score-width", @tabindex = 5 })
        @Html.Hidden("TextBoxHome3Q_hidden", match.BetStatusAccess.Home3Q)
    </td>
    <td class="score-betstatus home-away">
        @Html.TextBoxOrLabel(page, "TextBoxHomeOT", match.BetStatusAccess.HomeOt, false, new { @class = "score-width", @tabindex = 7 })
        @Html.Hidden("TextBoxHomeOT_hidden", match.BetStatusAccess.HomeOt)
    </td>
    <td class="score final-score-color home-away">
        @Html.TextBoxOrLabel(page, "TextBoxFinalHomeScore", match.FinalHomeScore, true, new { @class = "final-score-color total-score-width", @tabindex = 9 })
        @Html.Hidden("TextBoxFinalHomeScore_hidden", match.FinalHomeScore)
    </td>
}
@section AwayScore{
    <td class="score-betstatus">
        @Html.TextBoxOrLabel(page, "TextBoxAway1Q", match.BetStatusAccess.Away1Q, false, new { @class = "score-width", @tabindex = 2 })
        @Html.Hidden("TextBoxAway1Q_hidden", match.BetStatusAccess.Away1Q)
    </td>
    <td class="score-betstatus">
        @Html.TextBoxOrLabel(page, "TextBoxAway2Q", match.BetStatusAccess.Away2Q, false, new { @class = "score-width", @tabindex = 4 })
        @Html.Hidden("TextBoxAway2Q_hidden", match.BetStatusAccess.Away2Q)
    </td>
    <td class="score-betstatus">
        @Html.TextBoxOrLabel(page, "TextBoxAway3Q", match.BetStatusAccess.Away3Q, false, new { @class = "score-width", @tabindex = 6 })
        @Html.Hidden("TextBoxAway3Q_hidden", match.BetStatusAccess.Away3Q)
    </td>
    <td class="score-betstatus">
        @Html.TextBoxOrLabel(page, "TextBoxAwayOT", match.BetStatusAccess.AwayOt, false, new { @class = "score-width", @tabindex = 8 })
        @Html.Hidden("TextBoxAwayOT_hidden", match.BetStatusAccess.AwayOt)
    </td>
    <td class="score final-score-color">
        @Html.TextBoxOrLabel(page, "TextBoxFinalAwayScore", match.FinalAwayScore, true, new { @class = "final-score-color total-score-width", @tabindex = 10 })
        @Html.Hidden("TextBoxFinalAwayScore_hidden", match.FinalAwayScore)
    </td>
}