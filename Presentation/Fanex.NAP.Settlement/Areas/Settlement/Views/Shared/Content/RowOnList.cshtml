@using Fanex.NAP.Settlement.DTO.Domain
@using Fanex.NAP.Settlement.DTO.Permission;
@model Tuple<Match, SettlementPermission, PageType, String>
@{
    var match = Model.Item1; // Model Match
    var permission = Model.Item2; // Permission
    var page = Model.Item3; // Page view
    var oddOrEven = Model.Item4; // row Odd or Even
    var disabledAutoSettle = ViewBag.DisabledAutoSettle;//DisabledAutoSettle = NULL or 0  : ON, = 1 : OFF (Global "Auto-Settlment")
    var listAction = match.ListAction; // Model Log Action
    var actionFailed = Utility.GetActionStatusById(match.FailedActionId); // Action Failed
    var eventStatus = Utility.MapEventStatusString(match.EventStatus, match.IsPending, match.IsHtCal, match.IsCalculated);
    var backroundColor = match.FailedActionId.HasValue
        ? Utility.BackgroundColor(true, Background.ActionFailed)
        : Utility.BackgroundColor(match.IsUndecided, Background.Undecided);
    var autoSettle = "on";

    var permissionCalc = false;
    var permissionRefund = false;
    var permissionCloseMatch = false;
    if (permission.SportsBook.CanCalculate)
    {
        if (disabledAutoSettle)
        {
            permissionCalc = true;
        }
        else
        {
            permissionCalc = match.DisabledAutoSettle;
        }
    }

    if (permission.SportsBook.CanRefund)
    {
        if (disabledAutoSettle)
        {
            permissionRefund = true;
        }
        else
        {
            permissionRefund = match.DisabledAutoSettle;
        }
    }

    if (permission.SportsBook.CanCloseMatch)
    {
        if (disabledAutoSettle)
        {
            permissionCloseMatch = true;
        }
        else
        {
            permissionCloseMatch = match.DisabledAutoSettle;
        }
    }

    if (disabledAutoSettle || match.DisabledAutoSettle)//OFF
    {
        autoSettle = string.Empty;
    }
}
<tr class="row-@match.LeagueId @oddOrEven @backroundColor"
    data-match-id="@match.MatchId" data-match-code="@match.MatchCode" data-sport-id="@match.SportType">
    <td class="code" rowspan="2">
        <span class='@(permission.CanViewSettlementLog ? "act-match-log code-link" : "no-link")'>@match.MatchCode</span>
    </td>
    <td class="kick-off-time" rowspan="2">
        @match.KickOffTime.ToString("yyyy-MM-dd")
        <br />
        @match.KickOffTime.ToString("hh:mm:ss tt")
    </td>
    <td class="home-away">
        <div class="match-home @match.BetStatusAccess.HomeGoal">
            @match.HomeName @(Convert.ToBoolean(match.IsNeutral) ? " (N)" : string.Empty)
        </div>
    </td>
    @RenderSection("HomeScore")
    <td rowspan="2" class='event-status event-status-@match.MatchId @Utility.BackgroundColorEventStatus(eventStatus, match.IsPending)'>
        <span class="running">@eventStatus
           @if (eventStatus.Equals(EventStatus.Running, StringComparison.OrdinalIgnoreCase))
           {
            if (permissionCloseMatch)
            {
                <i id="close-@match.MatchId" class='on close-match'></i>
            }
            else
            {
                <i id="close-@match.MatchId" class='off close-match'/>
            }
           }
        </span>
        <br />
        <span style="color: Red">@actionFailed</span>
    </td>
    <td rowspan="2" class="calc-refund @Utility.BackgroundColorCalculate(match.IsHtCal, match.IsCalRefund, match.IsCalculated)">
        @if (permissionCalc)
        {
            <div id="calc-@match.MatchId" class='code-link act-calculate'>
                Calc
            </div>
        }
        else
        {
            <div id="calc-@match.MatchId">
                Calc
            </div>
        }
    </td>
    <td rowspan="2" class="calc-refund">
        @if (permissionRefund)
        {
            <div id="refund-@match.MatchId" class='act-refund code-link'>
                Refund</div>
        }
        else
        {
            <div id="refund-@match.MatchId">
                Refund</div>
        }
    </td>
    @if (page == PageType.OverOnly)
    {
        <td rowspan="2" class="calc-mp">@match.BetCount
        </td>
    }
    else
    {
        var background = string.Empty;
        if (match.IsMultiCaled != match.IsRefund)
        {
            background = match.IsMultiCaled ? Background.Calculated : Background.Refund;
        }
        <td rowspan="2" class="calc-mp @background">
            @if (match.IsKeyScore && permission.SportsBook.CanCalculateMixParlay)
            {
                if (string.IsNullOrEmpty(autoSettle))
                {
                @Html.CheckBox("CheckBoxCalc-" + match.MatchId,
                               new { @class = "multiple-league-name parlay-chk match-chk league-" + match.LeagueId, @data_matchcode = match.MatchCode })
                }
                else
                {
                @Html.CheckBox("CheckBoxCalc-" + match.MatchId,
                               new { @disabled = "disabled", @class = "multiple-league-name parlay-chk match-chk league-" + match.LeagueId, @data_matchcode = match.MatchCode })
                }
            }
            else
            {
                @Html.CheckBox("CheckBoxCalc-" + match.MatchId, new { @disabled = "disabled" })
            }
        </td>
    }
    <td rowspan="2" class="auto-set">
        <i id="auto-settle-@match.MatchId" class="act-auto-settle @autoSettle"></i>
    </td>
    <td rowspan="2" class="confirm">
        @Html.Action("ListAction", "Sportsbook", new { groupSport = match.GroupSport, listAction })
    </td>
</tr>
<tr class="row-@match.LeagueId @oddOrEven @backroundColor">
    <td>
        <div class="match-away @match.BetStatusAccess.AwayGoal">
            @match.AwayName
        </div>
    </td>
    @RenderSection("AwayScore")
</tr>