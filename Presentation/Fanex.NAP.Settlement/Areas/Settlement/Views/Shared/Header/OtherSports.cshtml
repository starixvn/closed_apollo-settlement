@model BaseViewModel
@{
    switch (Model.PageType)
    {
        case PageType.Refund:
        case PageType.Calc:
            Layout = "RowOnPopup.cshtml";
            break;
        default:
            Layout = "RowOnList.cshtml";
            break;
    }
}
@section Score{
    <th rowspan="2" class="score">
        @ViewResources.HTScore
    </th>
    <th rowspan="2" class="score">
        @ViewResources.FinalScore
    </th>
}