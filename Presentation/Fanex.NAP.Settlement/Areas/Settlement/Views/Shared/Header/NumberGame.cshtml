<div class="head-table">
    <table class="table-calculation">
        <colgroup class="number-game">
            <col class="code" />
            <col class="kick-off-time" />
            <col class="event" />
            <col class="result-game" />
            <col class="event-status" />
            <col class="action" />
            <col class="confirm" />
        </colgroup>
        <thead>
            <tr>
                <th>
                    @ViewResources.MatchCode
                </th>
                <th>
                    @ViewResources.KickOffTime
                </th>
                <th>
                    @ViewResources.Event
                </th>
                <th>
                    @ViewResources.Result
                </th>
                <th>
                    @ViewResources.EventStatus
                </th>
                <th>
                    @ViewResources.Calculation
                </th>
                <th>
                    @ViewResources.Confirm
                </th>
            </tr>
        </thead>
    </table>
</div>