@model BaseViewModel
@{
    switch (Model.PageType)
    {
        case PageType.Refund:
        case PageType.Calc:
            Layout = "RowOnPopup.cshtml";
            break;
        default:
            Layout = "RowOnList.cshtml";
            break;
    }
}
@section Score{
    <th class="score-betstatus" rowspan="2">
        @ViewResources._1P
    </th>
    <th class="score-betstatus" rowspan="2">
        @ViewResources._2P
    </th>
    <th class="score-betstatus" rowspan="2">
        @ViewResources._3P
    </th>
    <th class="score-betstatus" rowspan="2">
        @ViewResources.OT
    </th>
    <th class="score" rowspan="2">
        @ViewResources.FinalScore
    </th>
}