{
    <td>
        @string.Format("{0} - {1}", betStatus.Home1Q, betStatus.Away1Q)
    </td>
    <td>
        @string.Format("{0} - {1}", betStatus.Home2Q, betStatus.Away2Q)
    </td>
    <td>
