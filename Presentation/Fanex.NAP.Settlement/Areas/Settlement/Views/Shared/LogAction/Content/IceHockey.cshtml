@model MatchLog
@{var betStatus = Model.BetStatusAccess;}
@if (Model.ActionId > 0 && Model.ActionId < 11)
{
    <td>
        @string.Format("{0} - {1}", betStatus.Home1Q, betStatus.Away1Q)
    </td>
    <td>
        @string.Format("{0} - {1}", betStatus.Home2Q, betStatus.Away2Q)
    </td>
    <td>
        @string.Format("{0} - {1}", betStatus.Home3Q, betStatus.Away3Q)
    </td>
    <td>
        @string.Format("{0} - {1}", betStatus.HomeOt, betStatus.AwayOt)
    </td>
    <td>
        @string.Format("{0} - {1}", Model.FinalHomeScore, Model.FinalAwayScore)
    </td>
}
else
{
    <td>
    </td>
    <td>
    </td>
    <td>
    </td>
    <td>
    </td>
    <td>
    </td>
}