@model CalcViewModel
<div class="soccer">
    @if (this.Model.CurrentMatch.SportType == 1)
    {
        <div class="set-directly">
            @ViewResources.GoalRecord
            @if (this.Model.CurrentMatch.IsExistFGLG || this.Model.CurrentMatch.IsExistHTFGLG)
            {
                @Html.TextBox("GoalRecord", this.Model.CurrentMatch.GoalRecord, new { style = "width: 78px; text-transform:uppercase;", @tabindex = 5 });
            }
            else
            {
                @Html.TextBox("GoalRecord", this.Model.CurrentMatch.GoalRecord, new { @disabled = "disabled", style = "width: 78px" });
            }
        </div>
    }
    @Html.Hidden("IsExistFgLg", Model.CurrentMatch.IsExistFGLG)
    @Html.Hidden("IsExistHtFgLg", Model.CurrentMatch.IsExistHTFGLG)
    @Html.Hidden("BetStatus", Model.CurrentMatch.BetStatus)
    @Html.Hidden("IsLive", Model.CurrentMatch.IsLive.ToString())
</div>