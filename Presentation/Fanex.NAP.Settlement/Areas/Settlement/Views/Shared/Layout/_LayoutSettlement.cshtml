@using Fanex.NAP.Core.Configuration
<!DOCTYPE html>
<!--[if IEMobile 7]><html class="no-js iem7 oldie"><![endif]-->
<!--[if (IE 7)&!(IEMobile)]><html class="no-js ie7 oldie" lang="en"><![endif]-->
<!--[if (IE 8)&!(IEMobile)]><html class="no-js ie8 oldie" lang="en"><![endif]-->
<!--[if (IE 9)&!(IEMobile)]><html class="no-js ie9" lang="en"><![endif]-->
<!--[if (gt IE 9)|(gt IEMobile 7)]><!-->
<html lang="en">
<!--<![endif]-->
<head>
    <title>@ViewBag.Title</title>
    @Styles.Render("~/css/jquery-all")
    @Styles.Render("~/css/settlement")
</head>
<body>
    <div id="calculation">
        <div id="header-container">
            @{ Html.RenderPartial("~/Areas/UserControl/Header.cshtml"); }
        </div>
        <div id="filter-container">
            @RenderSection("ContentFilter")
        </div>
        <div id="content-cotainer">
            @RenderBody()
        </div>
        <div class="loading">
        </div>
        <div class="block-body">
        </div>
        <div style="display: none;" id="dialog-confirm-calc-mp">
            <div style="margin: 7px 7px;" id="msgContent">
            </div>
        </div>
    </div>
    @Scripts.Render("~/scripts/jquery-all")
    @Scripts.Render("~/scripts/settlement")
    @RenderSection("scripts", required: false)
    <script type="text/javascript">
        Site.unBlockUI();
        Site.getAbsoluteUrl = function (relativeUrl) {
            return '@Url.Content("~/")' + relativeUrl;
        };
        Calculate.initialize();

        $('.tooltip').tipsy({
            live: true,
            gravity: 'se'
        });
    </script>
    @if (NapSettings.Settings.EnableReCheckIn)
    {
        <script src="~/Areas/UserLogin/scripts/ReCheckIn.js" type="text/javascript"></script>
    }
</body>
</html>