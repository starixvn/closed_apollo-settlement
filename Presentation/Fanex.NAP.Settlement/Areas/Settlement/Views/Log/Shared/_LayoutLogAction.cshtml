<head>
    <title>@ViewBag.Title</title>
    @Styles.Render("~/css/action-log")
</head>
<body class="popup">
    <div id="log-action">
        <div class="content-cotainer">
            @RenderBody()
        </div>
    </div>
    @Scripts.Render("~/scripts/jquery-ui")
    @Scripts.Render("~/scripts/action-log")
    <script type="text/ecmascript">
        Site.unBlockUI();
        Site.getAbsoluteUrl = function (relativeUrl) {
            return '@Url.Content("~/")' + relativeUrl;
        };

    </script>
</body>
</html>